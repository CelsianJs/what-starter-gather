{
  "headers": [
    {
      "source": "/",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "source": "/recipes/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=3600"
      }
    },
    {
      "source": "/planner",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "source": "/shopping-list",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "source": "/build",
      "headers": {
        "Cache-Control": "public, max-age=600"
      }
    }
  ]
}
